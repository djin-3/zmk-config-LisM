#define ZMK_POINTING_DEFAULT_SCRL_VAL 200

#include <behaviors.dtsi>
#include <behaviors/naginata.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/mouse.h>
#include "lism_layers.h"

&mt {
    tapping-term-ms = <300>;
    flavor = "balanced";
};

&lt {
    quick-tap-ms = <300>;
};


/ {
    macros {

        ng_on: ng_on {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LANGUAGE_1 &kp INTERNATIONAL_4 &to L_NAGI>
                ;
        };
        ng_off: ng_off {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LANGUAGE_2 &kp INTERNATIONAL_5 &to L_DEF>
                ;
        };
        emoji: emoji_macro {
            compatible = "zmk,behavior-macro";
            label = "EMOJI";
            #binding-cells = <0>;
            bindings = 
                <&macro_press &kp CAPSLOCK>,
                <&macro_tap &kp E>,
                <&macro_release &kp CAPSLOCK>;
        };
    };

    behaviors {
        encoder_msc: sensor_rotate_msc {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;
            tap-ms = <20>;
        };

        encoder_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };
    };


    combos {
        compatible = "zmk,combos";
        combo_ng_on {
            timeout-ms = <300>;
            key-positions = <15 16>;
            bindings = <&ng_on>;
            layers = <L_DEF>;
        };
        combo_ng_off {
            timeout-ms = <300>;
            key-positions = <13 14>;
            bindings = <&ng_off>;
            layers = <L_DEF L_NAGI>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default Layer";
            bindings = <
                &kp Q            &kp W              &kp E                 &kp R                   &kp T                                                  &kp Y          &kp U            &kp I              &kp O               &kp P
                &kp A            &mt LALT S         &mt LSHIFT D          &mt LGUI F              &mt LCTRL G                                            &mt RCTRL H    &mt RGUI J       &mt RSHIFT K       &mt RALT L          &lt L_MARK SEMICOLON
                &kp Z            &kp X              &kp C                 &kp V                   &kp B                                                  &kp N          &kp M            &kp COMMA          &kp DOT             &kp SLASH
                &lt L_DEV DELETE &none              &lt L_MHOLD TAB       &msc SCRL_UP            &lt L_NUM SPACE   &lt L_MARK ESC      &lt L_MARK BACKSPACE &lt L_NUM ENTER &msc SCRL_UP &kp F7             &kp F10             &lt L_DEV F12 
                                                    &msc SCRL_LEFT        &msc SCRL_DOWN          &msc SCRL_RIGHT                                        &msc SCRL_LEFT &msc SCRL_DOWN   &msc SCRL_RIGHT
            >;
            sensor-bindings = <&encoder_msc SCRL_UP SCRL_DOWN>;
        };

        number_layer {  // L_NUM
            display-name = "Number Layer";
            bindings = <
                &trans           &kp NUMBER_7       &kp NUMBER_8          &kp NUMBER_9            &kp EQUAL                                              &kp F1         &kp F2           &kp F7             &kp F10             &kp RSHIFT
                &kp ASTERISK     &mt LALT NUMBER_4  &mt LSHIFT NUMBER_5   &mt LGUI NUMBER_6       &mt LCTRL MINUS                                        &mkp MB1       &kp LEFT         &kp UP             &kp RIGHT           &kp RGUI
                &kp SLASH        &kp NUMBER_1       &kp NUMBER_2          &kp NUMBER_3            &kp PLUS                                               &mkp MB2       &none            &kp DOWN           &none               &kp RALT
                &trans           &kp DOT            &kp NUMBER_0          &kp UP                  &kp LANG2         &trans              &trans           &kp LANG1      &kp UP           &kp RS(RC(TAB))    &kp RC(TAB)         &kp F12 
                                                    &kp LEFT              &kp DOWN                &kp RIGHT                                              &kp LEFT       &kp DOWN         &kp RIGHT
            >;
            sensor-bindings = <&encoder_kp C_VOL_UP C_VOL_DN>;
        };

        mark_layer {  // L_MARK
            display-name = "Mark Layer";
            bindings = <
                &kp LS(LG(N4))   &kp F4             &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS   &none                                                  &kp TILDE      &kp EXCLAMATION  &kp AT_SIGN        &kp HASH            &kp DOLLAR
                &emoji           &kp F5             &kp LEFT_BRACKET      &kp RIGHT_BRACKET       &none                                                  &kp GRAVE      &kp UNDER        &kp SINGLE_QUOTE   &kp DOUBLE_QUOTES   &kp BACKSLASH
                &kp KP_NUMLOCK   &kp F11            &kp LEFT_BRACE        &kp RIGHT_BRACE         &none                                                  &kp PIPE       &kp PERCENT      &kp CARET          &kp AMPERSAND       &kp ASTERISK
                &trans           &trans             &kp NUMBER_0          &trans                  &kp SPACE         &trans              &trans           &kp ENTER      &trans           &none              &none               &kp F12 
                                                    &trans                &trans                  &trans                                                 &trans         &trans           &trans
            >;
        };

        device_layer {  // L_DEV
            display-name = "Device Layer";
            bindings = <
                &none            &none              &none                 &none                   &bt BT_CLR                                             &bt BT_SEL 0   &bt BT_SEL 1     &bt BT_SEL 2       &bt BT_SEL 3        &bt BT_SEL 4
                &none            &none              &none                 &none                   &none                                                  &none          &none            &none              &none               &none
                &sys_reset       &none              &none                 &none                   &none                                                  &none          &none            &none              &none               &sys_reset
                &bootloader      &bt BT_CLR_ALL     &none                 &none                   &none             &none               &studio_unlock   &none          &none            &none              &none               &bootloader
                                                    &trans                &trans                  &trans                                                 &trans         &trans           &trans
            >;
        };

        naginata_layer {  // L_NAGI
            display-name = "Naginata";
            bindings = <
                &ng Q  &ng W  &ng E  &ng R  &ng T                                  &ng Y  &ng U  &ng I      &ng O    &ng P
                &ng A  &ng S  &ng D  &ng F  &ng G                                  &ng H  &ng J  &ng K      &ng L    &ng SEMI
                &ng Z  &ng X  &ng C  &ng V  &ng B                                  &ng N  &ng M  &ng COMMA  &ng DOT  &ng SLASH
                &trans &trans &trans &trans &ng SPACE &trans    &trans &ng ENTER &trans &trans &trans &trans
                              &trans &trans &trans                                 &trans &trans &trans
            >;
        };

        mouse_layer {  // L_MOUSE: トラックボールを動かすと自動で入る（zip_temp_layer）。薙刀式より上
            display-name = "Mouse Layer";
            // 右手: J=左クリック K=右クリック I=中クリック L=押している間ボールでスクロール ;=右Ctrl /=右Shift
            // 左手: F=左クリック D=右クリック E=中クリック S=押している間ボールでスクロール A=左Ctrl Z=左Shift
            // ここに置いたキーの位置は overlay の excluded-positions に入れて、押してもマウス層を抜けないようにする
            bindings = <
                &trans         &trans         &mkp MCLK      &trans         &trans         &trans         &trans         &mkp MCLK      &trans         &trans
                &kp LCTRL      &mo L_SCROLL   &mkp RCLK      &mkp LCLK      &trans         &trans         &mkp LCLK      &mkp RCLK      &mo L_SCROLL   &kp RCTRL
                &kp LSHIFT     &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &kp RSHIFT
                &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans
                &trans         &trans         &trans         &trans         &trans         &trans
            >;
        };

        scroll_layer {  // L_SCROLL: マウス層の S か L を押している間だけ。ボールの動きをスクロールに変える（overlay 側）
            display-name = "Scroll Layer";
            bindings = <
                &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans
                &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans
                &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans
                &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans
                &trans         &trans         &trans         &trans         &trans         &trans
            >;
        };

        mouse_hold_layer {  // L_MHOLD: Tab を押している間だけ。中身はマウス層と同じ。オートマウスの対象外なので1秒で切れない
            display-name = "Mouse Hold";
            bindings = <
                &trans         &trans         &mkp MCLK      &trans         &trans         &trans         &trans         &mkp MCLK      &trans         &trans
                &kp LCTRL      &mo L_SCROLL   &mkp RCLK      &mkp LCLK      &trans         &trans         &mkp LCLK      &mkp RCLK      &mo L_SCROLL   &kp RCTRL
                &kp LSHIFT     &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &kp RSHIFT
                &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans
                &trans         &trans         &trans         &trans         &trans         &trans
            >;
        };
    };

};